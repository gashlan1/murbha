# ┌─────────────────────────────────────────────┐
# │   Nafath Backend Proxy — Environment Vars    │
# └─────────────────────────────────────────────┘
# Copy to `.env` and fill in real values.
# NEVER commit `.env` to git.

# Credentials issued by Rabet portal (https://rabet.elm.sa)
NAFATH_APP_ID=fu5ofq88
NAFATH_APP_KEY=a79fe84a66f34f76bb63dbba04b7eaa2

# Upstream Nafath base URL (per Rabet OpenAPI spec)
# - Production:   https://rabet-nafath.api.elm.sa
# - Mock/Sandbox: https://mock-service.api.elm.sa/nafath
NAFATH_BASE_URL=https://rabet-nafath.api.elm.sa

# Local proxy port
PORT=3000

# ┌─────────────────────────────────────────────┐
# │   Session                                    │
# └─────────────────────────────────────────────┘
# Required in production. Server throws at boot if NODE_ENV=production and
# this is unset, to prevent signing cookies with the dev fallback.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ┌─────────────────────────────────────────────┐
# │   Resend (transactional email)              │
# └─────────────────────────────────────────────┘
# Get a key at https://resend.com/api-keys
# If RESEND_API_KEY is empty, sends are no-ops (logged to stdout) — good for local dev.
RESEND_API_KEY=
# Verified sender. Defaults to onboarding@resend.dev (Resend test sender, only
# delivers to your verified account email). Replace with a verified domain for
# production, e.g. "Murbha <noreply@murbha.sa>"
RESEND_FROM=

# Public URL used in templated links (optional; defaults to current request host).
APP_PUBLIC_URL=

# ┌─────────────────────────────────────────────┐
# │   Postgres (durable backend; optional)      │
# └─────────────────────────────────────────────┘
# When set AND the optional `pg` dependency is installed, the JSON-file store
# is replaced by a Postgres-backed JSONB document. Required on Render
# (filesystem doesn't persist between deploys).
# Render Postgres: copy the "External Database URL" from the dashboard.
DATABASE_URL=
# Set to 'disable' to turn off TLS (rare; e.g. local docker).
DATABASE_SSL=

# ┌─────────────────────────────────────────────┐
# │   Payments (provider abstraction)            │
# └─────────────────────────────────────────────┘
# One of: mock | hyperpay | moyasar. Defaults to mock when unset.
# Mock validates cards/IBANs but never charges. Switch to hyperpay/moyasar
# only after implementing the matching adapter in lib/payments.js.
PAYMENT_PROVIDER=mock

# HyperPay (KSA payment gateway)
# Sandbox: https://eu-test.oppwa.com (test endpoint base used by lib/payments-hyperpay.js)
# Prod:    https://eu-prod.oppwa.com — switch by env vars below.
HYPERPAY_BASE_URL=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=

# ┌─────────────────────────────────────────────┐
# │   SMS (transactional OTP + alerts)          │
# └─────────────────────────────────────────────┘
# One of: mock | unifonic | twilio. Defaults to mock.
SMS_PROVIDER=mock
# Unifonic (KSA-native, best in-country deliverability)
UNIFONIC_APP_SID=
UNIFONIC_SENDER=Murbha
# Twilio (international fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ┌─────────────────────────────────────────────┐
# │   Sanctions / PEP screening                 │
# └─────────────────────────────────────────────┘
# One of: mock | complyadvantage. Defaults to mock.
SANCTIONS_PROVIDER=mock
COMPLYADVANTAGE_API_KEY=

# ┌─────────────────────────────────────────────┐
# │   Web Push (VAPID)                          │
# └─────────────────────────────────────────────┘
# Required to actually send pushes. Without these, /app/push/* still
# works but sends are dry-runs (logged). Generate keys with:
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'P-256'});console.log('pub:',k.publicKey.export({format:'jwk'}).x);console.log('prv:',k.privateKey.export({format:'jwk'}).d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@murbha.sa

# ┌─────────────────────────────────────────────┐
# │   Backups (periodic db.json snapshots)      │
# └─────────────────────────────────────────────┘
# Snapshots land in data/uploads/backups/ as gzipped JSON. Disabled by
# default. Use as a safety net only — Render's filesystem is ephemeral.
# Real durability path is Postgres (DATABASE_URL above).
BACKUPS_ENABLED=
BACKUP_INTERVAL_MIN=360
BACKUP_RETENTION_DAYS=14
