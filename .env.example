# مُرابحة Platform — Environment Variables
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://murbha:murbha@localhost:5432/murbha

# Auth
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000

# Outbound SMTP (optional) — when set, /api/contact notifies the operator inbox.
# /api/newsletter persists to Postgres regardless; export the list to your
# vendor (Mailchimp/ConvertKit/SES) later.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_FROM="Murbha <no-reply@murbha.com>"
# NOTIFY_TO=ops@murbha.com
