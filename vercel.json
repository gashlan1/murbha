{
  "version": 2,
  "name": "murbha-platform",
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "routes": [
    { "src": "/sw.js",    "headers": { "Cache-Control": "no-cache" }, "dest": "/sw.js" },
    { "src": "/",         "dest": "/hessa.html" },
    { "src": "/home",     "dest": "/hessa.html" },
    { "src": "/projects", "dest": "/projects.html" },
    { "src": "/project",  "dest": "/project.html" },
    { "src": "/portfolio","dest": "/portfolio.html" },
    { "src": "/profile",  "dest": "/profile.html" },
    { "src": "/login",    "dest": "/auth.html" },
    { "src": "/register", "dest": "/auth.html" },
    { "src": "/signup",   "dest": "/auth.html" },
    { "src": "/notifications", "dest": "/notifications.html" },
    { "src": "/help",     "dest": "/help.html" },
    { "src": "/contract", "dest": "/contract.html" },
    { "src": "/legal",    "dest": "/legal.html" },
    { "src": "/privacy",  "dest": "/privacy.html" },
    { "src": "/terms",    "dest": "/terms.html" },
    { "src": "/risk",     "dest": "/risk.html" },
    { "src": "/sharia",   "dest": "/sharia.html" },
    { "src": "/aml",      "dest": "/aml.html" },
    { "src": "/kyc",      "dest": "/kyc.html" },
    { "src": "/complaints","dest": "/complaints.html" },
    { "src": "/cookies",  "dest": "/cookies.html" },
    { "src": "/(.*)\\.html$", "dest": "/$1.html" },
    { "src": "/(.*)",     "dest": "/404.html",
      "status": 404 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/shared.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/shared.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
